{
  "name": "micronotes-voice",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.30",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "^57.1.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "start:dev": "expo start --dev-client",
    "start:go": "expo start --go",
    "ios:dev": "npx eas-cli@latest build --platform ios --profile development",
    "apk:dev": "npx eas-cli@latest build --platform android --profile development",
    "apk:dev-wear": "npx eas-cli@latest build --platform android --profile development-wear",
    "apk:standalone": "npx eas-cli@latest build --platform android --profile standalone",
    "apk:phone": "npx eas-cli@latest build --platform android --profile preview",
    "apk:wear": "npx eas-cli@latest build --platform android --profile wear",
    "aab:wear": "npx eas-cli@latest build --platform android --profile wear-store"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "private": true
}
