{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "22.13.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "development-wear": {
      "extends": "development",
      "env": {
        "WEAR_OS": "1"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "standalone": {
      "extends": "preview"
    },
    "wear": {
      "extends": "preview",
      "env": {
        "WEAR_OS": "1"
      }
    },
    "wear-store": {
      "extends": "base",
      "autoIncrement": true,
      "env": {
        "WEAR_OS": "1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "wear-store": {
      "android": {
        "track": "internal"
      }
    }
  }
}
